# ---------------------------------------------------------------------------
# Company Brain — environment configuration. Copy to `.env` and fill in.
# ---------------------------------------------------------------------------

# --- LLM (Google ADK + Gemini) ---------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# minimal | low | medium | high. Lower = faster/cheaper; empty = model default.
GEMINI_THINKING_LEVEL=low
# "gemini" = real model. "mock" = deterministic offline test double (no key needed).
LLM_MODE=gemini

# --- Vector store (Qdrant) --------------------------------------------------
# Server mode (docker compose / `make qdrant`). Leave QDRANT_URL empty to use
# an embedded on-disk store at QDRANT_PATH instead.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=
QDRANT_COLLECTION=company_brain_kb

# --- Embeddings (run locally via fastembed, no API key) ---------------------
DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPARSE_MODEL=Qdrant/bm25
EMBEDDING_CACHE_DIR=.cache/models

# --- Retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
# Dense cosine thresholds used by the "not enough information" gate.
RELEVANCE_MIN=0.35
RELEVANCE_HIGH=0.55

# --- Agent guardrails -------------------------------------------------------
# Retrieval tools (search/get_document/list) and the finishing tools (check_compliance/save_creative_brief)
# have separate per-turn budgets so heavy research can never starve the compliance step.
MAX_TOOL_CALLS_PER_TURN=12
MAX_ACTION_CALLS_PER_TURN=6
MAX_LLM_CALLS_PER_TURN=14
MAX_MESSAGE_CHARS=2000

# --- API server -------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Optional shared secret for the WebSocket (?token=...). Empty = disabled.
WS_AUTH_TOKEN=
WS_MAX_MESSAGES_PER_MINUTE=20
SESSION_DB_URL=sqlite+aiosqlite:///data/runtime/sessions.db
KB_DIR=data/knowledge_base
OUTPUT_DIR=data/runtime/briefs
LOG_LEVEL=INFO
# text | json (use json in containers / log aggregators)
LOG_FORMAT=text
# Ingest the KB on startup when the collection is empty (convenient for dev; disable in prod).
AUTO_INGEST=true
